# Waveshare ESP32-S3-RGB-Matrix: ESP32-S3-N32R16 - 32MB flash, 16MB PSRAM.
# partitions-8m.csv only uses 8MB of the 32MB available, same as
# printspy-cam's Freenove board (16MB flash, same 8m partition table) -
# plenty of headroom, not the under-sizing bug nulllab hit (that was
# declaring MORE flash than physically present, not less).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8m.csv"
# ESP-IDF's default flash-size setting (2MB) is too small for
# partitions-8m.csv's ~6.1MB table - build fails at partition-table
# generation without this. 8MB matches the table's actual span; real
# physical flash is 32MB (see comment above) but there's no reason to
# declare more than the partition table uses.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=y
# Confirmed, not assumed: the schematic (docs/ESP32-S3-RGB-Matrix-
# Schematics.pdf) labels the module "ESP32-S3-WROOM-2-N32R16V" - WROOM-2
# is the module family that exclusively uses octal PSRAM (that's the
# actual distinguishing feature vs WROOM-1, which is quad-only). No
# ambiguity here the way there was for board_pins.h's GPIO numbers.
CONFIG_SPIRAM_MODE_OCT=y
