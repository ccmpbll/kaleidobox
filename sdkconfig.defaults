# Reduce binary size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_NEWLIB_NANO_FORMAT=y

# Left at INFO (the ESP-IDF default) rather than WARN - printspy-cam learned
# the hard way that suppressing INFO blinds you to your own ESP_LOGI calls
# (WiFi connect attempts, success/failure, AP start) during real bring-up
# bugs. Revisit once things are actually working and binary size matters
# more than visibility.

# Required for AP-mode WiFi provisioning - off by default in ESP-IDF
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Required for /ws/draw (instant-draw mode) - esp_http_server's WebSocket
# support is off by default too. Found by an actual build failure
# (httpd_ws_recv_frame/HTTPD_WS_TYPE_TEXT/httpd_uri_t.is_websocket all
# undeclared without it), not assumed up front.
CONFIG_HTTPD_WS_SUPPORT=y

# Browsers open several parallel connections to the setup/admin page; the
# draw-mode WebSocket and gallery/log SSE streams each hold one open too.
# Default (10) can starve requests under real use - same reasoning as
# printspy-cam.
CONFIG_LWIP_MAX_SOCKETS=16

# kaleidobox_http_server_start() (httpd_start + registering all ~16 URI
# handlers) runs inline on whatever task calls it - the WiFi IP_EVENT
# handler, i.e. ESP-IDF's own system event task, not a task of ours.
# That task's default stack (2304 bytes) was thin enough already; it
# overflowed for real once the handler count grew - confirmed via a
# real crash log ("stack overflow in task sys_evt"), not a guess.
# Doubled for headroom rather than trimmed to the observed edge.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Real phone photos are multi-MB uploads (/api/upload). ESP-IDF's default
# TCP window (5760 bytes = 4x MSS) forces many small recv round trips for
# a body that size - measured on real hardware: a 3.5MB upload spent
# 39.4s just in the httpd_req_recv loop (vs 2.2s to actually decode it)
# before this change, ~89KB/s effective throughput on a local WiFi link
# that should easily do multiple MB/s. Board has 16MB PSRAM and headroom
# in internal RAM (LWIP TCP buffers are internal-RAM-only), so there's no
# reason to keep the conservative low-RAM-device default.
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_SNDMBOX_SIZE=32
