# Reduce binary size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_NEWLIB_NANO_FORMAT=y

# Left at INFO (the ESP-IDF default) rather than WARN - printspy-cam learned
# the hard way that suppressing INFO blinds you to your own ESP_LOGI calls
# (WiFi connect attempts, success/failure, AP start) during real bring-up
# bugs. Revisit once things are actually working and binary size matters
# more than visibility.

# Required for AP-mode WiFi provisioning - off by default in ESP-IDF
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Required for /ws/draw (instant-draw mode) - esp_http_server's WebSocket
# support is off by default too. Found by an actual build failure
# (httpd_ws_recv_frame/HTTPD_WS_TYPE_TEXT/httpd_uri_t.is_websocket all
# undeclared without it), not assumed up front.
CONFIG_HTTPD_WS_SUPPORT=y

# Browsers open several parallel connections to the setup/admin page; the
# draw-mode WebSocket and gallery/log SSE streams each hold one open too.
# Default (10) can starve requests under real use - same reasoning as
# printspy-cam.
#
# This is the WHOLE SYSTEM's socket budget, not just httpd's - shared
# with weather.c's outbound HTTPS client, printspy.c's persistent MQTT
# connection, and mDNS. httpd_server.c's own config.max_open_sockets
# (currently 13, to give a single browser tab real headroom over its own
# per-origin connection limit) was raised without raising this - so
# httpd alone could claim most of a 16-socket total, confirmed live:
# esp-tls failing to even create a socket for weather's fetch
# ("Failed to create socket ... family 2") and httpd itself failing to
# accept new connections, both logging errno 23 (too many open files) -
# a real regression, not a guess. Headroom for httpd's 13 plus weather +
# MQTT + mDNS + DNS + slack.
CONFIG_LWIP_MAX_SOCKETS=24
# Kept in step with MAX_SOCKETS above - a socket descriptor being
# available doesn't help if the active-TCP-PCB table underneath it is
# still capped lower.
CONFIG_LWIP_MAX_ACTIVE_TCP=24

# kaleidobox_http_server_start() (httpd_start + registering all ~16 URI
# handlers) runs inline on whatever task calls it - the WiFi IP_EVENT
# handler, i.e. ESP-IDF's own system event task, not a task of ours.
# That task's default stack (2304 bytes) was thin enough already; it
# overflowed for real once the handler count grew - confirmed via a
# real crash log ("stack overflow in task sys_evt"), not a guess.
# Doubled for headroom rather than trimmed to the observed edge.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Real phone photos are multi-MB uploads (/api/upload). ESP-IDF's default
# TCP window (5760 bytes = 4x MSS) forces many small recv round trips for
# a body that size - measured on real hardware: a 3.5MB upload spent
# 39.4s just in the httpd_req_recv loop (vs 2.2s to actually decode it)
# before this change, ~89KB/s effective throughput on a local WiFi link
# that should easily do multiple MB/s. Board has 16MB PSRAM and headroom
# in internal RAM (LWIP TCP buffers are internal-RAM-only), so there's no
# reason to keep the conservative low-RAM-device default.
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_SNDMBOX_SIZE=32

# Every other background task in this codebase (kaleidoscope, gallery_bg,
# display_rotation) is explicitly pinned to core 1, opposite WiFi/httpd's
# core 0, specifically to avoid contending with network processing (see
# each task's own xTaskCreatePinnedToCore comment). esp-mqtt's own client
# task (printspy.c's MQTT connection) is the one exception - it's created
# internally by the esp-mqtt component, not our own xTaskCreate call, and
# defaults to unpinned (tskNO_AFFINITY) unless explicitly told otherwise.
# Pinned here to match this codebase's own established convention.
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_1=y

# Default FATFS config (CONFIG_FATFS_LFN_NONE) is 8.3 short names only -
# confirmed on real hardware: gallery.c saved a file as "red.raw" and it
# came back as "RED.RAW" on disk. Not just cosmetic - 8.3 also caps the
# name part at 8 characters, so any gallery save name longer than that
# would get silently mangled (e.g. "SUNSET~1.RAW"), breaking delete/
# lookup by the name the user actually typed. Heap (not stack) variant -
# LFN work buffers are only allocated transiently per file op, and this
# board has PSRAM headroom to spare.
CONFIG_FATFS_LFN_HEAP=y
